HOST=0.0.0.0
PORT=8000
DEFAULT_FPS=10
MODEL_NAME=data/yolov8n.onnx
CONF_THRESHOLD=0.4
# Legacy ONVIF defaults for other camera operations. Anonymous discovery does
# not use these credentials; enter a login only after selecting a device.
ONVIF_USER=
ONVIF_PASS=

# --- Streaming latency ---
# Longest side sent to the browser; 0 keeps the camera resolution.
STREAM_MAX_WIDTH=1280
# Longest side used for detection and face matching; higher keeps small
# phones and distant faces detectable. 0 keeps the camera resolution.
DETECT_MAX_WIDTH=1920
# Seconds between person-detection runs (0 = every frame).
DETECT_INTERVAL=0.2
# Seconds between face-recognition runs.
FACE_INTERVAL=1.0
# Keep a face-identified track through brief occlusions (seconds).
TRACK_MAX_GAP=2.0
# Forget a name if no fresh face match for this long (seconds).
TRACK_IDENTITY_TTL=30.0
# Conservative appearance-only reconnect threshold (0..1); raise to avoid false matches.
TRACK_VISUAL_THRESHOLD=0.88
# "tcp" is reliable; "udp" is lower latency on a clean LAN.
RTSP_TRANSPORT=tcp
# Ask FFmpeg to decode with low delay instead of buffering.
RTSP_LOW_LATENCY=1

# --- Phone-use detection ---
# Full-frame COCO "cell phone" confidence threshold (0..1).
PHONE_CONF_THRESHOLD=0.25
# Lower threshold for the per-person crop pass that finds small phones.
PHONE_CROP_CONF_THRESHOLD=0.15
# Largest people re-scanned for phones per frame (CPU bound).
PHONE_CROP_MAX_PEOPLE=4
# The frame is also scanned as an N x N grid of person-dense tiles; 0 disables it.
PHONE_TILE_GRID=2
# Tiles scanned per pass, busiest first.
PHONE_TILE_MAX=1
# Margin around each tile as a fraction of its size.
PHONE_TILE_OVERLAP=0.15
# Confidence threshold for the tile pass.
PHONE_TILE_CONF_THRESHOLD=0.20
# Seconds between phone/person geometric analyses.
PHONE_USE_INTERVAL=0.5
# Active use must last this many seconds before an alert is sent.
PHONE_USE_MIN_SECONDS=2.0
# Tolerate brief detector dropouts (seconds).
PHONE_USE_GRACE_SECONDS=1.0
# An episode survives a detector dropout of up to this long (seconds).
PHONE_USE_EPISODE_SECONDS=3.0
# Share of the recent analyses that must show phone use before alerting.
PHONE_USE_EVIDENCE=0.5
# Do not alert again for the same person track within this many seconds.
PHONE_ALERT_COOLDOWN=120
# Head-pitch ratio that counts as looking down (0 = eyes, 1 = mouth).
PHONE_LOOK_PITCH_RATIO=0.70
# Optional binary phone-use classifier (using / not using). Activated when
# weights exist; classifier-only detections are labelled "phone use (model)".
PHONE_CLASSIFIER_MODEL=data/phone_detection_model.tflite
PHONE_CLASSIFIER_THRESHOLD=0.80
# Maximum largest person crops per phone analysis; reduce for slow CPUs.
PHONE_CLASSIFIER_MAX_PEOPLE=4
# Initial default for uncertain/low-score snapshot collection; UI Training
# switch overrides and persists this value in SQLite without a restart.
# Sensitive imagery stays on disk in data/review/; default is OFF.
REVIEW_CAPTURE=0
REVIEW_MAX_SAMPLES=2000
# Initial per-camera rolling-hour cap; Training UI overrides persist in SQLite.
REVIEW_CAPTURE_PER_HOUR=1

# --- Sign-in and accounts ---
# The default admin/12345 account is created only when the users table is empty.
# Change the password after the first sign-in (sidebar: Password).
# Session lifetime in hours; expired sessions are rejected server-side.
CCTV_SESSION_HOURS=12
# PBKDF2-HMAC-SHA256 work factor for stored password hashes.
CCTV_AUTH_ITERATIONS=240000
# Wrong passwords in a row before the account is locked; an admin unlocks it.
CCTV_MAX_FAILED_ATTEMPTS=3
# Secure cookie flag: auto (HTTPS only), 1 (always) or 0 (never).
CCTV_SECURE_COOKIE=auto
